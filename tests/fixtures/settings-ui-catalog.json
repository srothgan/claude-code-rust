    {
      "id": "permissions.allow",
      "label": "Allow rules",
      "description": "Add one entry per tool rule, e.g. Bash(npm run test *) or Read(./docs/**). Lists merge across scopes; deny rules take precedence.",
      "key_path": [
        "permissions",
        "allow"
      ],
      "kind": "string_list",
      "category": "permissions",
      "editor": {
        "type": "array",
        "item": {
          "type": "string",
          "description": "Enter one tool permission rule, for example Read(./src/**) or Bash(npm test *). Use a separate entry for each rule."
        }
      },
      "options": [],
      "writable_scopes": [
        "user",
        "project",
        "local"
      ],
      "allows_custom": true,
      "reset": "Reset clears this scope's value and uses the other scopes or Default.",
      "application": "next_session"
    },
    {
      "id": "sandbox.credentials",
      "label": "Credential protection",
      "description": "Configure file, environment-variable and AWS credential protection. Choose a collection and add an entry; required fields are marked. Native platform restrictions apply. No credentials are read or injected while editing.",
      "key_path": [
        "sandbox",
        "credentials"
      ],
      "kind": "json",
      "category": "sandbox",
      "editor": {
        "type": "object",
        "fields": [
          {
            "key": "files",
            "label": "Credential files",
            "schema": {
              "type": "array",
              "item": {
                "type": "object",
                "fields": [
                  {
                    "key": "path",
                    "label": "File path",
                    "schema": {
                      "type": "string",
                      "description": "Enter a filesystem path. Paths keep their native settings-file meaning; the editor does not open the file."
                    },
                    "required": true
                  },
                  {
                    "key": "mode",
                    "label": "Protection mode",
                    "schema": {
                      "type": "string",
                      "options": [
                        "deny",
                        "mask"
                      ],
                      "description": "deny blocks access to the credential; mask substitutes a sentinel inside the sandbox."
                    },
                    "required": true
                  },
                  {
                    "key": "extract",
                    "label": "Extraction pattern",
                    "schema": {
                      "type": "string",
                      "description": "Optional regular expression for mask mode: capture group 1 contains the credential."
                    }
                  },
                  {
                    "key": "onExtractNoMatch",
                    "label": "If extraction finds nothing",
                    "schema": {
                      "type": "string",
                      "options": [
                        "warn",
                        "deny",
                        "error"
                      ],
                      "description": "When extraction finds nothing: warn leaves it readable, deny blocks access, error stops sandbox setup. Native restrictions apply for JWT decoding."
                    }
                  },
                  {
                    "key": "decode",
                    "label": "Encoded credential format",
                    "schema": {
                      "type": "string",
                      "options": [
                        "jwt"
                      ],
                      "description": "Mask a JWT with a structurally valid substitute. Reset this field to use ordinary masking."
                    }
                  },
                  {
                    "key": "maskClaims",
                    "label": "JWT claims to mask",
                    "schema": {
                      "type": "array",
                      "item": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "key": "injectHosts",
                    "label": "Injection hosts",
                    "schema": {
                      "type": "array",
                      "item": {
                        "type": "string"
                      },
                      "description": "Add one allowed injection host per entry, for example api.example.com."
                    }
                  },
                  {
                    "key": "maskDuplicates",
                    "label": "Mask repeated values",
                    "schema": {
                      "type": "boolean"
                    }
                  }
                ]
              },
              "description": "Add a credential file, then set its required path and protection mode. Optional fields control extraction and injection."
            }
          },
          {
            "key": "envVars",
            "label": "Environment variables",
            "schema": {
              "type": "array",
              "item": {
                "type": "object",
                "fields": [
                  {
                    "key": "name",
                    "label": "Variable name",
                    "schema": {
                      "type": "string",
                      "description": "Enter an environment variable name, for example API_TOKEN. Enter the name, not its secret value."
                    },
                    "required": true
                  },
                  {
                    "key": "mode",
                    "label": "Protection mode",
                    "schema": {
                      "type": "string",
                      "options": [
                        "deny",
                        "mask"
                      ],
                      "description": "deny blocks access to the credential; mask substitutes a sentinel inside the sandbox."
                    },
                    "required": true
                  },
                  {
                    "key": "extract",
                    "label": "Extraction pattern",
                    "schema": {
                      "type": "string",
                      "description": "Optional regular expression for mask mode: capture group 1 contains the credential."
                    }
                  },
                  {
                    "key": "onExtractNoMatch",
                    "label": "If extraction finds nothing",
                    "schema": {
                      "type": "string",
                      "options": [
                        "warn",
                        "deny",
                        "error"
                      ],
                      "description": "When extraction finds nothing: warn leaves it readable, deny blocks access, error stops sandbox setup. Native restrictions apply for JWT decoding."
                    }
                  },
                  {
                    "key": "decode",
                    "label": "Encoded credential format",
                    "schema": {
                      "type": "string",
                      "options": [
                        "jwt"
                      ],
                      "description": "Mask a JWT with a structurally valid substitute. Reset this field to use ordinary masking."
                    }
                  },
                  {
                    "key": "maskClaims",
                    "label": "JWT claims to mask",
                    "schema": {
                      "type": "array",
                      "item": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "key": "injectHosts",
                    "label": "Injection hosts",
                    "schema": {
                      "type": "array",
                      "item": {
                        "type": "string"
                      },
                      "description": "Add one allowed injection host per entry, for example api.example.com."
                    }
                  }
                ]
              },
              "description": "Add an environment variable, then set its required name and protection mode. No secret values are read while editing."
            }
          },
          {
            "key": "awsPairs",
            "label": "AWS credential pairs",
            "schema": {
              "type": "array",
              "item": {
                "type": "object",
                "fields": [
                  {
                    "key": "accessKeyIdVar",
                    "label": "Access key variable",
                    "schema": {
                      "type": "string",
                      "description": "Enter an environment variable name, for example API_TOKEN. Enter the name, not its secret value."
                    },
                    "required": true
                  },
                  {
                    "key": "secretAccessKeyVar",
                    "label": "Secret key variable",
                    "schema": {
                      "type": "string",
                      "description": "Enter an environment variable name, for example API_TOKEN. Enter the name, not its secret value."
                    },
                    "required": true
                  },
                  {
                    "key": "sessionTokenVar",
                    "label": "Session token variable",
                    "schema": {
                      "type": "string",
                      "description": "Enter an environment variable name, for example API_TOKEN. Enter the name, not its secret value."
                    }
                  }
                ]
              },
              "description": "Add a pair and enter the required access-key and secret-key variable names. The session-token variable is optional."
            }
          },
          {
            "key": "allowPlaintextInject",
            "label": "Allow plain HTTP injection",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "key": "sigv4",
            "label": "AWS request policies",
            "schema": {
              "type": "object",
              "fields": [
                {
                  "key": "streaming",
                  "label": "Streaming requests",
                  "schema": {
                    "type": "string",
                    "options": [
                      "deny",
                      "passthrough"
                    ]
                  }
                },
                {
                  "key": "presigned",
                  "label": "Presigned requests",
                  "schema": {
                    "type": "string",
                    "options": [
                      "deny",
                      "passthrough"
                    ]
                  }
                },
                {
                  "key": "sigv4a",
                  "label": "Sigv4a",
                  "schema": {
                    "type": "string",
                    "options": [
                      "deny",
                      "passthrough"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "description": "Choose a collection to add credential protection, or edit the optional request policies. Required fields are marked; save after completing them."
      },
      "options": [],
      "writable_scopes": [
        "user"
